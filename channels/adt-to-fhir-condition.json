{
  "id": "adt-to-fhir-condition",
  "name": "ADT diagnoses to FHIR Condition facade",
  "enabled": true,
  "source": { "type": "mllp", "port": 6663 },
  "pipeline": [
    { "type": "filter.hl7Type", "allow": ["ADT^A01", "ADT^A04", "ADT^A08", "ADT^A31"] },
    { "type": "split.hl7Segment", "segment": "DG1" },
    { "type": "transform.mapping", "mapping": "adt-condition" }
  ],
  "destinations": [{ "id": "facade", "type": "fhirstore", "ordered": true }]
}
