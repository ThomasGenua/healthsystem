# Template only. Compose does NOT load this file automatically.
# Select a host/provider and register the HTTPS callback before enabling OIDC.
NORTHSTAR_AUTH_MODE=apikey+oauth
NORTHSTAR_PUBLIC_ORIGIN=https://staging.example.invalid
NORTHSTAR_OIDC_ISSUER=https://identity.example.invalid
NORTHSTAR_OIDC_AUDIENCE=replace-with-api-audience
NORTHSTAR_PORTAL_CLIENT_ID=replace-with-registered-client
NORTHSTAR_PORTAL_CLIENT_SECRET_FILE=/run/secrets/portal-client-secret
NORTHSTAR_PORTAL_SCOPES=openid patient/*.read
NORTHSTAR_TLS_CERT=/run/secrets/tls-cert
NORTHSTAR_TLS_KEY=/run/secrets/tls-key
NORTHSTAR_BACKUP_REMOTE=s3://replace-with-staging-bucket/synthetic-only
NORTHSTAR_BACKUP_KEY_FILE=/run/secrets/backup-key
NORTHSTAR_DEV_IDP=off
NORTHSTAR_DEV_MALWARE_SCANNER=off
NORTHSTAR_RATE_LIMIT=on
