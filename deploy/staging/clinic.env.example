# Template only. Compose does NOT load this file automatically.
# Select a host/provider and register the HTTPS callback before enabling OIDC.
HEALTHSYSTEMS_AUTH_MODE=apikey+oauth
HEALTHSYSTEMS_PUBLIC_ORIGIN=https://staging.example.invalid
HEALTHSYSTEMS_OIDC_ISSUER=https://identity.example.invalid
HEALTHSYSTEMS_OIDC_AUDIENCE=replace-with-api-audience
HEALTHSYSTEMS_PORTAL_CLIENT_ID=replace-with-registered-client
HEALTHSYSTEMS_PORTAL_CLIENT_SECRET_FILE=/run/secrets/portal-client-secret
HEALTHSYSTEMS_PORTAL_SCOPES=openid patient/*.read
HEALTHSYSTEMS_TLS_CERT=/run/secrets/tls-cert
HEALTHSYSTEMS_TLS_KEY=/run/secrets/tls-key
HEALTHSYSTEMS_BACKUP_REMOTE=s3://replace-with-staging-bucket/synthetic-only
HEALTHSYSTEMS_BACKUP_KEY_FILE=/run/secrets/backup-key
HEALTHSYSTEMS_DEV_IDP=off
HEALTHSYSTEMS_DEV_MALWARE_SCANNER=off
HEALTHSYSTEMS_RATE_LIMIT=on
