# Template only. Compose does NOT load this file automatically.
# Select a host/provider and register the HTTPS callback before enabling OIDC.
HEALTHSYSTEM_AUTH_MODE=apikey+oauth
HEALTHSYSTEM_PUBLIC_ORIGIN=https://staging.example.invalid
HEALTHSYSTEM_OIDC_ISSUER=https://identity.example.invalid
HEALTHSYSTEM_OIDC_AUDIENCE=replace-with-api-audience
HEALTHSYSTEM_PORTAL_CLIENT_ID=replace-with-registered-client
HEALTHSYSTEM_PORTAL_CLIENT_SECRET_FILE=/run/secrets/portal-client-secret
HEALTHSYSTEM_PORTAL_SCOPES=openid patient/*.read
HEALTHSYSTEM_TLS_CERT=/run/secrets/tls-cert
HEALTHSYSTEM_TLS_KEY=/run/secrets/tls-key
HEALTHSYSTEM_BACKUP_REMOTE=s3://replace-with-staging-bucket/synthetic-only
HEALTHSYSTEM_BACKUP_KEY_FILE=/run/secrets/backup-key
HEALTHSYSTEM_DEV_IDP=off
HEALTHSYSTEM_DEV_MALWARE_SCANNER=off
HEALTHSYSTEM_RATE_LIMIT=on
